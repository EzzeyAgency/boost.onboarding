# Copy to .env.local for local development. Never commit real values.

# Neon Postgres pooled connection string (Vercel adds this automatically when you connect Neon)
DATABASE_URL=

# Auth.js: generate with `npx auth secret` or `openssl rand -base64 33`
AUTH_SECRET=
# Google OAuth client (Google Cloud Console > APIs & Services > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated admin allowlist. Only these Google accounts can sign in to /leads.
ADMIN_EMAILS=analytics@ezzey.com

# Public links shown in the onboarding flow
NEXT_PUBLIC_LEADSIE_CONNECT_URL=https://app.leadsie.com/connect/ezzey/manage
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://business.google.com/
NEXT_PUBLIC_GBP_SETUP_VIDEO_URL=https://www.youtube.com/watch?v=VrawbXIY3V4

# Optional: HighLevel inbound webhooks.
# Support requests (support.submitted) go to HIGHLEVEL_SUPPORT_WEBHOOK_URL.
# Onboarding events (onboarding.submitted, onboarding.progress_saved) go to HIGHLEVEL_ONBOARDING_WEBHOOK_URL.
# HIGHLEVEL_WEBHOOK_URL is a catch-all for any event without its own URL.
HIGHLEVEL_SUPPORT_WEBHOOK_URL=
HIGHLEVEL_ONBOARDING_WEBHOOK_URL=
HIGHLEVEL_WEBHOOK_URL=
# Optional: public site address used in links sent to HighLevel (defaults to the request's own address)
PUBLIC_BASE_URL=https://boostclients.ezzey.com
